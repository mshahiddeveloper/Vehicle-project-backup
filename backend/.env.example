# SafarPK Backend Environment Configuration (.env.example)
# PostgreSQL 16 / Neon Serverless Connection Pooling

# DATABASE_URL: Pooled connection string with PgBouncer for serverless query execution
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/safarpk_production?sslmode=require&pgbouncer=true"

# DIRECT_URL: Direct unpooled connection for migrations and Prisma schema push
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample.ap-southeast-1.aws.neon.tech/safarpk_production?sslmode=require"

# JWT Authentication
JWT_SECRET="generate-a-cryptographically-secure-random-256-bit-key-here"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Upstash Redis / Local Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

PORT=3001
NODE_ENV="production"
