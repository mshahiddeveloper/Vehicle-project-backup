# ==============================================================================
# SafarPK Frontend Environment Template (.env.example)
# Next.js 14 App Router + Vercel Fluid Compute
# ==============================================================================

# Neon PostgreSQL 16 Pooled Connection (for serverless route handlers & Prisma / Neon Driver)
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/safarpk_production?sslmode=require&pgbouncer=true"

# Neon PostgreSQL 16 Direct Connection (for unpooled / migration operations)
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample.ap-southeast-1.aws.neon.tech/safarpk_production?sslmode=require"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="safarpk-media"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_key"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="safarpk-media"

# Application URL
NEXT_PUBLIC_APP_URL="https://safarpk.vercel.app"
