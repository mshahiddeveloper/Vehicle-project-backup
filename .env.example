# ==============================================================================
# SafarPK Unified Environment Variables Template
# Architecture: Next.js 14 App Router + Vercel Fluid Compute + Neon PostgreSQL 16 + Cloudinary
# ==============================================================================

# --- Neon PostgreSQL 16 (Serverless Connection Pooling) ---
# DATABASE_URL: Pooled connection string with PgBouncer for serverless handlers (Fluid Compute)
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/safarpk_production?sslmode=require&pgbouncer=true"

# DIRECT_URL: Direct unpooled connection string for migrations and DDL operations
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample.ap-southeast-1.aws.neon.tech/safarpk_production?sslmode=require"

# --- Cloudinary Media Storage (OWASP ASVS Level 2+ Secure Image Pipelines) ---
CLOUDINARY_CLOUD_NAME="safarpk-media"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_key"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="safarpk-media"

# --- Security & Auth Configuration ---
JWT_SECRET="generate-a-cryptographically-secure-random-256-bit-key-here"
NEXT_PUBLIC_APP_URL="https://safarpk.vercel.app"
NODE_ENV="production"

